# ── Supabase ──────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com, then run supabase/schema.sql
# in its SQL Editor. Find these values under Project Settings > API.
# Leaving these blank is fine — the site falls back to bundled sample
# products so you can browse and test everything before connecting a database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tinytreasurecloset.com

# ── WhatsApp Ordering ─────────────────────────────────────────────────────
# International format, digits only, no leading + or spaces (e.g. 233241234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=233241234567
# How the same number is displayed to customers (with formatting)
NEXT_PUBLIC_WHATSAPP_DISPLAY="+233 24 123 4567"

# ── Business Info ─────────────────────────────────────────────────────────
NEXT_PUBLIC_BUSINESS_NAME="Tiny Treasure Closet"
NEXT_PUBLIC_BUSINESS_PHONE="+233 24 123 4567"
NEXT_PUBLIC_BUSINESS_EMAIL=hello@tinytreasurecloset.com
NEXT_PUBLIC_BUSINESS_ADDRESS="East Legon, Accra, Ghana"
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/tinytreasurecloset
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/tinytreasurecloset
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@tinytreasurecloset
# Get an embed URL from Google Maps > Share > Embed a map > copy the src="..." value
NEXT_PUBLIC_GOOGLE_MAPS_EMBED=https://www.google.com/maps?q=East+Legon+Accra+Ghana&output=embed

# ── Shipping ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SHIPPING_FEE=25
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=400

# ── Mobile Money Accounts ─────────────────────────────────────────────────
NEXT_PUBLIC_MTN_MOMO_NUMBER="024 000 0000"
NEXT_PUBLIC_MTN_MOMO_NAME="Tiny Treasure Closet"
NEXT_PUBLIC_TELECEL_CASH_NUMBER="020 000 0000"
NEXT_PUBLIC_TELECEL_CASH_NAME="Tiny Treasure Closet"
NEXT_PUBLIC_AIRTELTIGO_NUMBER="027 000 0000"
NEXT_PUBLIC_AIRTELTIGO_NAME="Tiny Treasure Closet"
NEXT_PUBLIC_PAYMENT_INSTRUCTIONS="Send the total amount to the number below, take a screenshot of the confirmation, and upload it here before placing your order."
